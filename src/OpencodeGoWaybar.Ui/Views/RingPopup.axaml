<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OpencodeGoWaybar.Ui.Controls"
        xmlns:vm="using:OpencodeGoWaybar.Ui.ViewModels"
        x:Class="OpencodeGoWaybar.Ui.Views.RingPopup"
        x:DataType="vm:UsageWindowViewModel"
        Title="OpenCode Go Usage"
        Width="400" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Inter, Lato, sans-serif">

  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
    </Style>
    <Style Selector="TextBlock.micro">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
  </Window.Styles>

  <!-- The 14px margin is the shadow's room. Note this card rounds itself, so the
       Hyprland rule sets rounding = 0 for this window or you get a double edge. -->
  <Border Margin="14" CornerRadius="10" ClipToBounds="True"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource Hairline}"
          BorderThickness="1"
          BoxShadow="0 10 30 0 #73000000">
    <StackPanel>

      <!-- the header is also the drag handle, there being no title bar -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,18,22,0"
            PointerPressed="OnHeaderPressed">
        <Path Width="8" Height="8" VerticalAlignment="Center"
              Fill="{DynamicResource Ok}"
              Data="M4,0 L8,4 L4,8 L0,4 Z" />
        <TextBlock Grid.Column="1" Margin="9,0,0,0" FontSize="12"
                   VerticalAlignment="Center" Text="OPENCODE GO"
                   Foreground="{DynamicResource TextMuted}" />
        <TextBlock Grid.Column="2" Classes="micro" VerticalAlignment="Center"
                   Text="{Binding RefreshedLabel}" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Windows}" Margin="22,22,22,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UsageWindowGauge">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Panel Width="96" Height="96">
                <c:RingGauge Percent="{Binding Percent}"
                             Thickness="11"
                             Track="{DynamicResource TrackBg}"
                             Fill="{Binding StatusBrushKey,
                                    Converter={StaticResource BrushKeyConverter}}" />
                <TextBlock Classes="mono" FontSize="19"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{Binding StatusBrushKey,
                                        Converter={StaticResource RingTextConverter}}"
                           Text="{Binding PercentLabel}" />
              </Panel>
              <TextBlock FontSize="11.5" HorizontalAlignment="Center"
                         Text="{Binding ShortLabel}"
                         Foreground="{DynamicResource TextBody}" />
              <TextBlock Classes="micro" HorizontalAlignment="Center"
                         Text="{Binding CountdownShort}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Margin="22,16,22,0" Padding="13,11" CornerRadius="5"
              IsVisible="{Binding HasWarning}"
              Background="{DynamicResource WarnBg}"
              BorderBrush="{DynamicResource WarnBorder}"
              BorderThickness="1">
        <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarnText}"
                   Text="{Binding WarningText}" />
      </Border>

      <Border Margin="0,18,0,0" Padding="22,14"
              BorderBrush="{DynamicResource Hairline}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="mono" FontSize="11.5"
                     Foreground="{DynamicResource TextFaint}">
            <Run Text="{Binding TotalTokens, StringFormat='{}{0:N0}'}" />
            <Run Text=" tokens · 7d" />
          </TextBlock>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5"
                     Foreground="{DynamicResource TextPrimary}"
                     Text="{Binding TotalCost, StringFormat='{}{0:C2}'}" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
