<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OpencodeGoWaybar.Ui.Controls"
        xmlns:vm="using:OpencodeGoWaybar.Ui.ViewModels"
        x:Class="OpencodeGoWaybar.Ui.Views.UsageWindow"
        x:DataType="vm:UsageWindowViewModel"
        Title="OpenCode Go Usage"
        Width="880" Height="620"
        MinWidth="720" MinHeight="520"
        Background="{DynamicResource WindowBg}"
        FontFamily="Inter, Lato, sans-serif">

  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
    </Style>
    <Style Selector="TextBlock.micro">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="0.9" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- toolbar. The mockup's Usage/Diagnostics tab strip is left out: there is
         no diagnostics view designed yet, and a dead tab is worse than none. -->
    <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
            Height="42" Padding="20,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="eyebrow" VerticalAlignment="Center"
                   Text="USAGE" />
        <TextBlock Grid.Column="2" Classes="micro" VerticalAlignment="Center"
                   Text="{Binding RefreshedLabel}" Margin="0,0,12,0" />
        <Button Grid.Column="3" Content="Refresh"
                Command="{Binding RefreshCommand}"
                BorderBrush="{DynamicResource AccentLine}"
                Foreground="{DynamicResource AccentText}"
                Background="Transparent" Padding="12,4" CornerRadius="4" />
      </Grid>
    </Border>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Windows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:UsageWindowGauge">
          <Border BorderBrush="{DynamicResource Hairline}"
                  BorderThickness="0,0,1,1" Padding="20,22">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Panel Width="82" Height="82">
                <c:RingGauge Percent="{Binding Percent}"
                             Thickness="9"
                             Track="{DynamicResource TrackBg}"
                             Fill="{Binding StatusBrushKey,
                                    Converter={StaticResource BrushKeyConverter}}" />
                <TextBlock Classes="mono" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{Binding PercentLabel}" />
              </Panel>
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock FontSize="12" Text="{Binding Label}"
                           Foreground="{DynamicResource TextBody}" />
                <TextBlock FontSize="10" LetterSpacing="0.6"
                           Text="{Binding StatusLabel}"
                           Foreground="{Binding StatusBrushKey,
                                        Converter={StaticResource BrushKeyConverter}}" />
                <TextBlock Classes="micro" Text="{Binding Countdown}" />
                <TextBlock Classes="micro" Text="{Binding ResetsAtUtc}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" IsVisible="{Binding HasWarning}"
            Background="{DynamicResource WarnBg}"
            BorderBrush="{DynamicResource WarnBorder}"
            BorderThickness="0,1" Padding="20,14">
      <TextBlock Classes="mono" FontSize="11"
                 Foreground="{DynamicResource WarnText}"
                 TextWrapping="Wrap" Text="{Binding WarningText}" />
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,320">

      <!-- DataGrid column bindings are ReflectionBinding on purpose: they resolve
           against the row type, which the compiled-binding pass cannot infer from
           the window's x:DataType. -->
      <DataGrid Grid.Column="0"
                ItemsSource="{Binding Days}"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                Background="{DynamicResource WindowBg}"
                BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Width="1.1*"
                              Binding="{ReflectionBinding DateLabel}" />
          <DataGridTextColumn Header="Tokens" Width="1*"
                              Binding="{ReflectionBinding TokensLabel}" />
          <DataGridTextColumn Header="Cost" Width="0.9*"
                              Binding="{ReflectionBinding CostLabel}" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="1,0,0,0" Padding="20,18">
        <StackPanel Spacing="13">
          <TextBlock Classes="eyebrow" Text="DAILY TOKENS" />

          <ItemsControl ItemsSource="{Binding DaysOldestFirst}" Height="104">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UsageWindowRow">
                <Border Margin="3.5,0" VerticalAlignment="Bottom"
                        CornerRadius="2,2,0,0"
                        ToolTip.Tip="{Binding TokensLabel}"
                        Height="{Binding BarFraction,
                                 Converter={StaticResource BarHeightConverter},
                                 ConverterParameter=104}"
                        Background="{Binding IsToday,
                                     Converter={StaticResource BarBrushConverter}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="micro" FontSize="10" Text="{Binding FirstDayLabel}" />
            <TextBlock Grid.Column="1" Classes="micro" FontSize="10"
                       Text="{Binding LastDayLabel}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource Hairline}" />

          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="7">
            <TextBlock Grid.Row="0" Classes="mono" FontSize="11" Text="7d total"
                       Foreground="{DynamicResource TextFaint}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="11"
                       Foreground="{DynamicResource TextBody}"
                       Text="{Binding TotalTokens, StringFormat='{}{0:N0}'}" />

            <TextBlock Grid.Row="1" Classes="mono" FontSize="11" Text="7d cost"
                       Foreground="{DynamicResource TextFaint}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="11"
                       Foreground="{DynamicResource TextBody}"
                       Text="{Binding TotalCost, StringFormat='{}{0:C2}'}" />

            <TextBlock Grid.Row="2" Classes="mono" FontSize="11" Text="peak day"
                       Foreground="{DynamicResource TextFaint}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="11"
                       Foreground="{DynamicResource TextBody}"
                       Text="{Binding PeakTokens, StringFormat='{}{0:N0}'}" />

            <TextBlock Grid.Row="3" Classes="mono" FontSize="11" Text="daily mean"
                       Foreground="{DynamicResource TextFaint}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" FontSize="11"
                       Foreground="{DynamicResource TextBody}"
                       Text="{Binding MeanTokens, StringFormat='{}{0:N0}'}" />

            <TextBlock Grid.Row="4" Classes="mono" FontSize="11" Text="$ / 1M tokens"
                       Foreground="{DynamicResource TextFaint}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" FontSize="11"
                       Foreground="{DynamicResource TextBody}"
                       Text="{Binding CostPerMillion, StringFormat='{}{0:C2}'}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
